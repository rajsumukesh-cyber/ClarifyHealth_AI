# ClarifyHealth AI Medical Report Simplifier Configuration

# Server & Security
PROJECT_NAME="ClarifyHealth AI Medical Report Simplifier"
SECRET_KEY="replace-this-with-a-secure-random-32-character-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite (Zero configuration needed):
DATABASE_URL="sqlite:///./medical_reports.db"
# Or PostgreSQL for production/Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medical_simplifier"

# AI Provider Settings ("gemini", "openai", "auto", "mock")
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Frontend
VITE_API_BASE_URL="http://localhost:8000"
